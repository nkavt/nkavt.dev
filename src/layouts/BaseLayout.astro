---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.tagline } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Navbar client:load currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>
